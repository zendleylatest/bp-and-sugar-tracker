ANDROID_PACKAGE_NAME=com.sugur.blood.playstore
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
IAP_ANDROID_STRICT_VERIFY=true

AMAZON_RVS_SHARED_SECRET=
AMAZON_RVS_SANDBOX=false

REGISTERED_REPORT_LIMIT=5
REGISTERED_FULL_DATA_ACCESS_LIMIT=5
REGISTERED_BMI_ENTRY_LIMIT=5
REGISTERED_BLOOD_PRESSURE_ENTRY_LIMIT=5
REGISTERED_BLOOD_GLUCOSE_ENTRY_LIMIT=5
# Guests and signed-up users share these free limits; Premium is unlimited.
CARE_REGISTERED_CHAT_LIMIT=5

# Server-side medication reminder pushes. PUSH_ENABLED turns on the scheduler
# (the app no longer schedules local reminders, so this must be true in production);
# DEBUG_ENABLED enables POST /api/medication-reminders/debug.
MEDICATION_REMINDER_PUSH_ENABLED=false
MEDICATION_REMINDER_DEBUG_ENABLED=false

# Admin hub integration (allapps-admin)
# Shared secret the hub sends as X-Service-Key to /api/admin/* and /api/knowledge.
# Generate a long random value (e.g. `openssl rand -hex 32`) and enter the same
# value as "serviceKey" for this app on the hub's Apps page.
INTERNAL_SERVICE_KEY=
# Optional extra key accepted as X-Knowledge-Key on /api/knowledge.
KNOWLEDGE_API_KEY=
# Admin panel login for this backend's own /api/admin/auth routes.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# OpenAI key: fetched at runtime from the key service using ADMIN_TOKEN (cached
# for OPENAI_KEY_CACHE_SECONDS, default 300). OPENAI_API_KEY is only a fallback.
ADMIN_TOKEN=
OPENAI_KEY_SERVICE_URL=https://openaikeysecret.oxmite.com/api-key
OPENAI_API_KEY=

# Google Sign-In: comma-separated OAuth client IDs accepted as the ID token
# audience. Must include the Firebase project's Web client ID
# (client_type 3 in google-services.json).
GOOGLE_CLIENT_ID=689913059892-2tt7463cfit13k1aolv4bl55qb4n126k.apps.googleusercontent.com
